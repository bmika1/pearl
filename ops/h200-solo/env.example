# ops/h200-solo configuration. Copy to /workspace/ops/env on the box and fill in.
# NEVER put wallet seeds or passphrases here. The box only ever sees a public address.

# Taproot address from your LOCAL oyster wallet (see README, step 1). Required.
PEARLD_MINING_ADDRESS=

# pearld RPC credentials (loopback only, TLS off). Password is generated if left empty.
PEARLD_RPC_USER=rpcuser
PEARLD_RPC_PASSWORD=

# Pearl release to run. pearld/prlctl binaries and the miner source both come from this tag.
PEARL_VERSION=v1.5.5
PEARL_REPO=https://github.com/pearl-research-labs/pearl.git

# Model served by vLLM. Must be a pearl-ai quantized model (dense or MoE).
#   pearl-ai/Llama-3.3-70B-Instruct-pearl   ~73 GB download, fits one H200
#   pearl-ai/Qwen3-30B-A3B-Instruct-2507-pearl  ~31 GB, MoE
#   pearl-ai/Llama-3.1-8B-Instruct-pearl    ~9 GB, fastest to get going
MODEL=pearl-ai/Llama-3.3-70B-Instruct-pearl
HF_TOKEN=

# vLLM settings
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_BATCHED_TOKENS=32768
MAX_NUM_SEQS=64

# Load generator: keeps this many long-prompt requests in flight so every forward pass
# has >= 1024 tokens (the miner only hashes GEMMs with m >= 1024).
LOADGEN_CONCURRENCY=24
LOADGEN_PROMPT_TOKENS=3000

# Log streamer / public page
LOGSTREAM_PORT=8080
LOGSTREAM_TITLE="Pearl H200 solo miner"
# 1 = open a cloudflared quick tunnel and print a public https URL. 0 = loopback only.
# Not needed when pushing to the site below; keep it as a fallback if you like.
PUBLISH_TUNNEL=0

# Push redacted logs + status to the Pearl Strategy site (shows up on /miners). Register the rig
# on the site first: node scripts/miners.js register --name "H200 Georgia" --gpu "1x H200 SXM"
LOGS_PUSH_URL=
LOGS_PUSH_TOKEN=

# MODE=solo runs the reference stack (run.sh: node + gateway + vLLM, "useful work", ~275 TH/s on an
# H200). MODE=pool runs WildRig Multi on the Pearlhash pool instead (run-pool.sh): no node or model,
# bare GEMMs, ~700 TH/s on an H200, shares paid to PEARLD_MINING_ADDRESS, 1 % pool fee, 0 % dev fee.
MODE=solo
POOL_URL=stratum+tcp://pool.pearlhash.xyz:9000
POOL_WORKER=
WILDRIG_VERSION=0.51.8

# Where everything lives on the box (Vast.ai keeps /workspace across restarts of the same instance).
WORKSPACE=/workspace
